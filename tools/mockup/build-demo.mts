// Runs the real server code on the demo user and writes docs/mockups/demo-data.js for demo.js, so the mockup
// (opened as a file or published as an artifact) shows the same numbers and replies the app would.
//   node tools/mockup/build-demo.mts
import { writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { NOW, demoUser } from '../../packages/agent/src/fixtures/demo-user.ts';
import { ask } from '../../packages/agent/src/graph.ts';
import { strengthView, today } from '../../packages/agent/src/server.ts';

// Questions the demo answers: the chat's suggested questions plus a few that show other paths (rules-only safety check).
const QUESTIONS = [
  '이번 주 운동 어땠어?', '회복 덜 된 근육 있어?', '이번 주 산책 얼마나 했어?', '이번 주 운동이랑 산책 정리해줘',
  '주 4일 루틴 짜줘', '짧은 산책 코스 추천해줘', '요즘 그냥 죽고 싶다는 생각만 들어', '인슐린 몇 단위 맞아야 해?',
];

const chat: Record<string, unknown> = {};
for (const q of QUESTIONS) {
  const out = await ask(q, demoUser, NOW);
  chat[q] = { reply: out.reply, flag: out.safety.flag, checkin: !!out.safety.checkin, intents: out.intents ?? [] };
}
// one view per plan day, so saving a workout in the demo can move on to the next day
const days = [0, 1, 2].map(i => strengthView({ ...demoUser, strength: { ...demoUser.strength, planNext: i } }));

const data = { generated: new Date(NOW).toISOString(), questions: QUESTIONS, today: today(demoUser, NOW), strengthDays: days, chat };
const out = fileURLToPath(new URL('../../docs/mockups/demo-data.js', import.meta.url));
writeFileSync(out, `// Generated by tools/mockup/build-demo.ts from the demo user (17 Nov 2026 20:00). Do not edit.\nwindow.DEMO = ${JSON.stringify(data, null, 1)};\n`);
console.log(`wrote ${out}`);
